local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
local currentRainbowColor = Color3.fromHSV((tick() * shared.RAINBOW_SPEED) % 1, 0.95, 1)
for obj, data in pairs(shared.activeEspStorage) do
local char = data.characterLink
local folder = data.folder
local targetModeMismatch = false
if shared.targetMode == "Players" and not data.isPlayerType then targetModeMismatch = true end
if shared.targetMode == "NPCs" and data.isPlayerType then targetModeMismatch = true end
if not char.Parent or not folder.Parent or targetModeMismatch then
if folder then folder:Destroy() end
shared.activeEspStorage[obj] = nil
continue
end
local hum = char:FindFirstChildOfClass("Humanoid")
local root = char:FindFirstChild("HumanoidRootPart")
if hum and root and localRoot and hum.Health > 0 then
local distance = math.floor((localRoot.Position - root.Position).Magnitude)
local currentWeapon = getEquippedWeapon(char)
local entityName = data.isPlayerType and obj.Name or char.Name
data.label.Text = string.format("[%s]\nName: %s | HP: %s | Studs: %d", currentWeapon, entityName, string.format("%.1f", hum.Health), distance)
local assignedColor = Color3.fromRGB(255, 60, 60)
if data.isPlayerType then
local isTeammate = localPlayer.Team and obj.Team and (localPlayer.Team == obj.Team)
local isFriend = localPlayer:IsFriendsWith(obj.UserId)
if isTeammate then
assignedColor = currentRainbowColor
elseif isFriend then
assignedColor = Color3.fromRGB(60, 255, 60)
elseif shared.wallEspEnabled and shared.isWallBetween(root) then
assignedColor = Color3.fromRGB(0, 120, 255)
end
else
assignedColor = Color3.fromRGB(235, 180, 40)
if shared.wallEspEnabled and shared.isWallBetween(root) then
assignedColor = Color3.fromRGB(160, 110, 20)
end
end
if data.highlight then
data.highlight.OutlineColor = assignedColor
data.highlight.FillColor = assignedColor
end
data.label.TextColor3 = assignedColor
for _, boxHandle in ipairs(data.boxes) do
if boxHandle and boxHandle.Parent then
boxHandle.Color3 = assignedColor
end
end
else
if folder then folder:Destroy() end
shared.activeEspStorage[obj] = nil
end
end
end
