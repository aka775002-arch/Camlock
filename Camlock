for _, segment in ipairs(shared.crosshairLines) do segment.BackgroundColor3 = dynamicColor end
end)
RunService.Stepped:Connect(function()
if shared.hitboxExpanded then
for part, _ in pairs(shared.originalHitboxData) do
if part and part.Parent and part.Parent:FindFirstChildOfClass("Humanoid") and part.Parent:FindFirstChildOfClass("Humanoid").Health > 0 then part.CanCollide = false end
end
