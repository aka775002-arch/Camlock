end)
shared.lockConnection = RunService.RenderStepped:Connect(function()
local hasTarget = shared.target and shared.target.Parent; local isAlive = hasTarget and shared.target.Parent:FindFirstChildOfClass("Humanoid") and shared.target.Parent:FindFirstChildOfClass("Humanoid").Health > 0
if shared.locked and isAlive and not (shared.wallCheckEnabled and shared.isWallBetween(shared.target)) then
local pos = shared.target.Position
if shared.PREDICTION_VALUE > 0.01 and shared.target.Parent:FindFirstChild("HumanoidRootPart") then
pos = pos + (shared.target.Parent.HumanoidRootPart.Velocity * ( (camera.CFrame.Position - pos).Magnitude / 1000 ) * shared.PREDICTION_VALUE)
end
local targetCFrame = CFrame.new(camera.CFrame.Position, pos); local localChar = localPlayer.Character
if shared.lockModalityMode == "CAMERA ONLY" or shared.lockModalityMode == "BOTH ACTIVE" then
camera.CFrame = shared.SMOOTHNESS_VALUE <= 0.01 and targetCFrame or camera.CFrame:Lerp(targetCFrame, math.clamp(1 - (shared.SMOOTHNESS_VALUE * 0.92), 0.01, 1))
end
if (shared.lockModalityMode == "BODY ONLY" or shared.lockModalityMode == "BOTH ACTIVE") and localChar and localChar.PrimaryPart then
localChar:SetPrimaryPartCFrame(CFrame.new(localChar.PrimaryPart.Position, Vector3.new(pos.X, localChar.PrimaryPart.Position.Y, pos.Z)))
end
else
if shared.locked then shared.locked = false; shared.target = nil; shared.textButton.Text = "CORE LOCK: OFF"; shared.textButton.TextColor3 = Color3.fromRGB(255, 60, 60); shared.clearTargetEsp() end
if shared.autolockEnabled and not shared.autolockCooldownActive then
local t = shared.getClosestTarget()
if t then shared.target = t; shared.locked = true; shared.textButton.Text = "CORE LOCK: ACTIVE"; shared.textButton.TextColor3 = Color3.fromRGB(0, 255, 150) end
end
end
end)
