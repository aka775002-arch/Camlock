function shared.resolveTargetPart(char)
	if not char then return nil end
	local name = shared.targetPartName
	local part = char:FindFirstChild(name)
	if part then return part end
	
	if name == "Torso" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso")
	elseif name == "Left Arm" then
		return char:FindFirstChild("LeftHand") or char:FindFirstChild("LeftLowerArm") or char:FindFirstChild("LeftUpperArm")
	elseif name == "Right Arm" then
		return char:FindFirstChild("RightHand") or char:FindFirstChild("RightLowerArm") or char:FindFirstChild("RightUpperArm")
	elseif name == "Left Leg" then
		return char:FindFirstChild("LeftFoot") or char:FindFirstChild("LeftLowerLeg") or char:FindFirstChild("LeftUpperLeg")
	elseif name == "Right Leg" then
		return char:FindFirstChild("RightFoot") or char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("RightUpperLeg")
	end
	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("Part")
end

local function revertSinglePart(part)
	local data = shared.originalHitboxData[part]
	if data and part and part.Parent then
		part.Size = data.Size
		part.Transparency = data.Transparency
		part.CanCollide = data.CanCollide
		part.Massless = data.Massless
	end
	shared.originalHitboxData[part] = nil
end

function shared.revertAllHitboxes()
	for part, data in pairs(shared.originalHitboxData) do
		if part and part.Parent then
			part.Size = data.Size
			part.Transparency = data.Transparency
			part.CanCollide = data.CanCollide
			part.Massless = data.Massless
		end
	end
	table.clear(shared.originalHitboxData)
end

local function isTeammate(char)
	if not shared.teamCheckEnabled then return false end
	local pObj = Players:GetPlayerFromCharacter(char)
	if pObj and localPlayer.Team and pObj.Team and localPlayer.Team == pObj.Team then
		return true
	end
	if pObj and pObj ~= localPlayer and tostring(pObj.Team) == tostring(localPlayer.Team) and localPlayer.Team ~= nil then
		return true
	end
	return false
end

function shared.applyHitboxExpansion(char)
	if not char or char == localPlayer.Character then return end
	
	local hum = char:FindFirstChildOfClass("Humanoid")
	local activePart = shared.resolveTargetPart(char)
	
	if not hum or hum.Health <= 0 then
		for part, _ in pairs(shared.originalHitboxData) do
			if part and part.Parent == char then
				revertSinglePart(part)
			end
		end
		return
	end
	
	for part, _ in pairs(shared.originalHitboxData) do
		if part and part.Parent == char and part ~= activePart then
			revertSinglePart(part)
		end
	end
	
	if activePart and activePart:IsA("BasePart") then
		local pObj = Players:GetPlayerFromCharacter(char)
		if pObj then
			if shared.friendCheckEnabled and localPlayer:IsFriendsWith(pObj.UserId) then return end
			if isTeammate(char) then return end
		end
		
		if not shared.originalHitboxData[activePart] then
			shared.originalHitboxData[activePart] = {
				Size = activePart.Size,
				Transparency = activePart.Transparency,
				CanCollide = activePart.CanCollide,
				Massless = activePart.Massless
			}
		end
		
		activePart.Size = Vector3.new(shared.hitboxSizeValue, shared.hitboxSizeValue, shared.hitboxSizeValue)
		activePart.Transparency = 0.65
		activePart.CanCollide = false
		activePart.Massless = true
	end
end

function shared.refreshHitboxState()
	if not shared.hitboxExpanded then 
		shared.revertAllHitboxes()
		return 
	end
	
	local currentEntities = {}
	if shared.targetMode == "Players" or shared.targetMode == "All" then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character then
				currentEntities[p.Character] = p
			end
		end
	end
	if shared.targetMode == "NPCs" or shared.targetMode == "All" then
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") and d ~= localPlayer.Character and not Players:GetPlayerFromCharacter(d) then
				currentEntities[d] = false
			end
		end
	end
	
	for part, _ in pairs(shared.originalHitboxData) do
		if part and part.Parent then
			local ent = currentEntities[part.Parent]
			local hum = part.Parent:FindFirstChildOfClass("Humanoid")
			if not ent or (hum and hum.Health <= 0) or isTeammate(part.Parent) then
				revertSinglePart(part)
			end
		else
			shared.originalHitboxData[part] = nil
		end
	end
	
	for char, _ in pairs(currentEntities) do
		shared.applyHitboxExpansion(char)
	end
end

function shared.getClosestTarget()
	local localChar = localPlayer.Character
	if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
	local closestTarget, shortestDistance = nil, math.huge
	local centerScreen = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	
	local function checkChar(char, pObj)
		if not char or char == localChar then return end
		local part = shared.resolveTargetPart(char)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if part and hum and hum.Health > 0 then
			if pObj then
				if shared.friendCheckEnabled and localPlayer:IsFriendsWith(pObj.UserId) then return end
				if isTeammate(char) then return end
			end
			
			local sPos, onScreen = camera:WorldToViewportPoint(part.Position)
			if onScreen and (Vector2.new(sPos.X, sPos.Y) - centerScreen).Magnitude < shared.FOV_RADIUS then
				local dist = (part.Position - localChar.HumanoidRootPart.Position).Magnitude
				if dist < shortestDistance then 
					if shared.wallCheckEnabled and shared.isWallBetween(part) then 
						return 
					end
					shortestDistance = dist
					closestTarget = part 
				end
			end
		end
	end
	
	if shared.targetMode == "Players" or shared.targetMode == "All" then
		for _, p in ipairs(Players:GetPlayers()) do 
			if p ~= localPlayer and p.Character then 
				checkChar(p.Character, p) 
			end 
		end
	end
	if shared.targetMode == "NPCs" or shared.targetMode == "All" then
		for _, d in ipairs(workspace:GetDescendants()) do 
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") and d ~= localChar and not Players:GetPlayerFromCharacter(d) then 
				checkChar(d, nil) 
			end 
		end
	end
	return closestTarget
end

