-- PART 2: PROXIMITY TARGETING ALGORITHMS & LIMB RESOLUTION
-- ============================================================================
local Players = game:GetService("Players")
local camera = workspace.CurrentCamera
local localPlayer = Players.LocalPlayer

function shared.resolveTargetPart(char)
	if not char then return nil end
	local name = shared.targetPartName
	local part = char:FindFirstChild(name)
	if part then return part end
	
	if name == "Torso" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso")
	elseif name == "Left Arm" then
		return char:FindFirstChild("LeftHand") or char:FindFirstChild("LeftLowerArm") or char:FindFirstChild("LeftUpperArm")
	elseif name == "Right Arm" then
		return char:FindFirstChild("RightHand") or char:FindFirstChild("RightLowerArm") or char:FindFirstChild("RightUpperArm")
	elseif name == "Left Leg" then
		return char:FindFirstChild("LeftFoot") or char:FindFirstChild("LeftLowerLeg") or char:FindFirstChild("LeftUpperLeg")
	elseif name == "Right Leg" then
		return char:FindFirstChild("RightFoot") or char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("RightUpperLeg")
	end
	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("Part")
end

function shared.getClosestTarget()
	local localChar = localPlayer.Character
	if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
	local closestTarget, shortestDistance = nil, math.huge
	local centerScreen = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	
	local function checkChar(char, pObj)
		if not char or char == localChar then return end
		local part = shared.resolveTargetPart(char)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if part and hum and hum.Health > 0 then
			-- Verification filtering loops for targeted properties configurations
			if pObj then
				if shared.friendCheckEnabled and localPlayer:IsFriendsWith(pObj.UserId) then return end
				if shared.teamCheckEnabled and localPlayer.Team and pObj.Team and (localPlayer.Team == pObj.Team) then return end
			end
			
			local sPos, onScreen = camera:WorldToViewportPoint(part.Position)
			if onScreen and (Vector2.new(sPos.X, sPos.Y) - centerScreen).Magnitude < shared.FOV_RADIUS then
				local dist = (part.Position - localChar.HumanoidRootPart.Position).Magnitude
				if dist < shortestDistance and not shared.isWallBetween(part) then 
					shortestDistance = dist
					closestTarget = part 
				end
			end
		end
	end
	if shared.targetMode == "Players" or shared.targetMode == "All" then
		for _, p in ipairs(Players:GetPlayers()) do 
			if p ~= localPlayer and p.Character then 
				checkChar(p.Character, p) 
			end 
		end
	end
	if shared.targetMode == "NPCs" or shared.targetMode == "All" then
		for _, d in ipairs(workspace:GetDescendants()) do 
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") and d ~= localChar and not Players:GetPlayerFromCharacter(d) then 
				checkChar(d, nil) 
			end 
		end
	end
	return closestTarget
end
