end
if shared.targetMode == "NPCs" or shared.targetMode == "All" then
for _, d in ipairs(workspace:GetDescendants()) do
if d:IsA("Model") and d:FindFirstChild("HumanoidRootPart") and d:FindFirstChildOfClass("Humanoid") and d ~= localPlayer.Character and not Players:GetPlayerFromCharacter(d) then
