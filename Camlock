local function createDrawingLine()
	local line = Drawing.new("Line")
	line.Visible = false
	line.Color = Color3.fromRGB(255, 60, 60)
	line.Thickness = 1.5
	line.Transparency = 1
	return line
end

local function createDrawingText()
	local text = Drawing.new("Text")
	text.Visible = false
	text.Color = Color3.fromRGB(255, 60, 60)
	text.Size = 14
	text.Center = true
	text.Outline = true
	text.Transparency = 1
	return text
end

function shared.clearTargetEsp()
	for pObj, data in pairs(shared.activeEspStorage) do
		if data.lines then
			for _, line in ipairs(data.lines) do
				line.Visible = false
			end
		end
		if data.label then
			data.label.Visible = false
		end
	end
end

function shared.makeEsp(plr)
	if not plr or plr == localPlayer then return end
	if shared.activeEspStorage[plr] then return end
	
	local lines = {}
	for i = 1, 12 do
		table.insert(lines, createDrawingLine())
	end
	
	local label = createDrawingText()
	
	shared.activeEspStorage[plr] = {
		lines = lines,
		label = label,
		playerLink = plr
	}
end

function shared.updateEspSectors()
	if not shared.espMasterEnabled then 
		shared.clearTargetEsp()
		return 
	end
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") then
			if not shared.activeEspStorage[p] then
				shared.makeEsp(p)
			end
		end
	end
	
	local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	local currentRainbowColor = Color3.fromHSV((tick() * shared.RAINBOW_SPEED) % 1, 0.95, 1)
	
	for plr, data in pairs(shared.activeEspStorage) do
		local char = plr.Character
		local lines = data.lines
		local label = data.label
		
		if not plr.Parent or not char or not char.Parent then
			for _, line in ipairs(lines) do line.Visible = false end
			label.Visible = false
			continue
		end
		
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		
		if hum and root and localRoot and hum.Health > 0 then
			local size = char:GetExtentsSize()
			local cframe = root.CFrame
			local halfX, halfY, halfZ = size.X / 2, size.Y / 2, size.Z / 2
			
			local corners3D = {
				cframe * Vector3.new(-halfX,  halfY, -halfZ), cframe * Vector3.new( halfX,  halfY, -halfZ),
				cframe * Vector3.new(-halfX,  halfY,  halfZ), cframe * Vector3.new( halfX,  halfY,  halfZ),
				cframe * Vector3.new(-halfX, -halfY, -halfZ), cframe * Vector3.new( halfX, -halfY, -halfZ),
				cframe * Vector3.new(-halfX, -halfY,  halfZ), cframe * Vector3.new( halfX, -halfY,  halfZ),
			}
			
			local corners2D = {}
			local allOnScreen = true
			
			for i, vec3D in ipairs(corners3D) do
				local vec2D, onScreen = camera:WorldToViewportPoint(vec3D)
				if not onScreen then allOnScreen = false break end
				corners2D[i] = Vector2.new(vec2D.X, vec2D.Y)
			end
			
			if allOnScreen then
				local assignedColor = Color3.fromRGB(255, 60, 60)
				local isTeammate = localPlayer.Team and plr.Team and (localPlayer.Team == plr.Team)
				local isFriend = localPlayer:IsFriendsWith(plr.UserId)
				
				if isTeammate then
					assignedColor = currentRainbowColor
				elseif isFriend then
					assignedColor = Color3.fromRGB(60, 255, 60)
				elseif shared.wallEspEnabled and shared.isWallBetween(root) then
					assignedColor = Color3.fromRGB(0, 120, 255)
				end
				
				local connections = {
					{1, 2}, {2, 4}, {4, 3}, {3, 1},
					{5, 6}, {6, 8}, {8, 7}, {7, 5},
					{1, 5}, {2, 6}, {3, 7}, {4, 8}
				}
				
				for index, pair in ipairs(connections) do
					local lineDraw = lines[index]
					lineDraw.From = corners2D[pair]
					lineDraw.To = corners2D[pair]
					lineDraw.Color = assignedColor
					lineDraw.Visible = true
				end
				
				local head = char:FindFirstChild("Head")
				if head then
					local headPos, headOnScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
					if headOnScreen then
						local distance = math.floor((localRoot.Position - root.Position).Magnitude)
						label.Text = string.format("%s | HP: %d | %dstuds", plr.Name, math.floor(hum.Health), distance)
						label.Position = Vector2.new(headPos.X, headPos.Y)
						label.Color = assignedColor
						label.Visible = true
					else
						label.Visible = false
					end
				end
			else
				for _, lineDraw in ipairs(lines) do lineDraw.Visible = false end
				label.Visible = false
			end
		else
			for _, lineDraw in ipairs(lines) do lineDraw.Visible = false end
			label.Visible = false
		end
	end
end

