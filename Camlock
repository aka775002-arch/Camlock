local sCorner = Instance.new("UICorner"); sCorner.CornerRadius = UDim.new(0, 4); sCorner.Parent = container
local stroke = Instance.new("UIStroke"); stroke.Thickness = 1.2; stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.ZIndex = 1; stroke.Parent = container; table.insert(shared.allStrokes, stroke)
local label = Instance.new("TextLabel"); label.Size = UDim2.new(1, 0, 0.45, 0); label.Position = UDim2.new(0, 0, 0, 2); label.BackgroundTransparency = 1; label.TextColor3 = Color3.fromRGB(240, 240, 255); label.TextSize = 9; label.Font = Enum.Font.GothamBold; label.Text = text .. ": " .. tostring(current); label.ZIndex = 1; label.Parent = container
table.insert(textSyncList, label)
local track = Instance.new("Frame"); track.Size = UDim2.new(0.85, 0, 0, 3); track.Position = UDim2.new(0.075, 0, 0.75, -2); track.BackgroundColor3 = Color3.fromRGB(24, 24, 36); track.ZIndex = 1; track.Parent = container
local fill = Instance.new("Frame"); fill.Size = UDim2.new((current - min) / (max - min), 0, 1, 0); fill.ZIndex = 1; fill.Parent = track; table.insert(shared.themeBackgrounds, fill)
local active = false
local function update(pos)
local pct = math.clamp((pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
local val = min + (pct * (max - min))
fill.Size = UDim2.new(pct, 0, 1, 0)
if name == "PredSlider" then shared.PREDICTION_VALUE = val label.Text = "PREDICTION: " .. string.format("%.2f", val)
elseif name == "SmoothSlider" then shared.SMOOTHNESS_VALUE = val label.Text = "SMOOTHNESS: " .. string.format("%.2f", val)
elseif name == "FovSlider" then shared.FOV_RADIUS = math.floor(val) label.Text = "FOV RADIUS: " .. shared.FOV_RADIUS .. "px"
elseif name == "HitboxSlider" then shared.hitboxSizeValue = val label.Text = "HITBOX SCALE: " .. string.format("%.1f", val)
elseif name == "SpeedSlider" then shared.walkSpeedValue = math.floor(val) label.Text = "WALK SPEED: " .. shared.walkSpeedValue
elseif name == "JumpSlider" then shared.jumpPowerValue = math.floor(val) label.Text = "JUMP POWER: " .. shared.jumpPowerValue end
end
container.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then active = true; update(i.Position) end end)
UserInputService.InputChanged:Connect(function(i) if active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i.Position) end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then active = false end end)
end
buildSliderFramework("PredSlider", "PREDICTION", 0, 10, shared.PREDICTION_VALUE)
buildSliderFramework("SmoothSlider", "SMOOTHNESS", 0, 1, shared.SMOOTHNESS_VALUE)
buildSliderFramework("FovSlider", "FOV RADIUS", shared.MIN_FOV_LIMIT, shared.MAX_FOV_LIMIT, shared.FOV_RADIUS)
