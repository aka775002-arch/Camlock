shared.lockConnection = RunService.RenderStepped:Connect(function()
	local hasTarget = shared.target and shared.target.Parent
	local isAlive = hasTarget and shared.target.Parent:FindFirstChildOfClass("Humanoid") and shared.target.Parent:FindFirstChildOfClass("Humanoid").Health > 0
	
	local wallFailure = false
	if shared.wallCheckEnabled and shared.target and shared.isWallBetween(shared.target) then
		wallFailure = true
	end

	if shared.locked and isAlive and not wallFailure then
		local basePosition = shared.target.Position
		
		if shared.PREDICTION_VALUE > 0.01 and shared.target.Parent:FindFirstChild("HumanoidRootPart") then
			local velocity = shared.target.Parent.HumanoidRootPart.Velocity
			local distance = (camera.CFrame.Position - basePosition).Magnitude
			basePosition = basePosition + (velocity * (distance / 1000) * shared.PREDICTION_VALUE)
		end
		
		local targetCFrame = CFrame.new(camera.CFrame.Position, basePosition)
		
		if shared.SMOOTHNESS_VALUE <= 0.01 then
			camera.CFrame = targetCFrame
		else
			local alphaFactor = math.clamp(1 - (shared.SMOOTHNESS_VALUE * 0.92), 0.01, 1)
			camera.CFrame = camera.CFrame:Lerp(targetCFrame, alphaFactor)
		end
	else
		if shared.locked then 
			shared.locked = false; shared.target = nil
			shared.textButton.Text = "CORE LOCK: OFF"; shared.textButton.TextColor3 = Color3.fromRGB(255, 60, 60) 
			shared.clearTargetEsp()
		end
		if shared.autolockEnabled and not shared.autolockCooldownActive then
			local t = shared.getClosestTarget()
			if t then shared.target = t; shared.locked = true; shared.textButton.Text = "CORE LOCK: ACTIVE"; shared.textButton.TextColor3 = Color3.fromRGB(0, 255, 150) end
		end
	end
end)

