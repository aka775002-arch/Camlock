-- Advanced Capture: Strict Real-World Distance Filtering First Mode
local function getClosestCharacterToCenter()
	local closestWorldDistance = math.huge
	local closestChar = nil
	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	local targetsToScan = {}
	
	if targetMode == "Players" or targetMode == "All" then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character and not isFriend(p) then table.insert(targetsToScan, p.Character) end
		end
	end
	
	if targetMode == "NPCs" or targetMode == "All" then
		for _, descendant in ipairs(workspace:GetDescendants()) do
			if descendant:IsA("Humanoid") and descendant.Parent and not Players:GetPlayerFromCharacter(descendant.Parent) then
				if descendant.Parent ~= localPlayer.Character then table.insert(targetsToScan, descendant.Parent) end
			end
		end
	end

	for _, character in ipairs(targetsToScan) do
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local trackingPart = getTargetPart(character)
		
		if humanoid and humanoid.Health > 0 and trackingPart then
			local screenPos, onScreen = camera:WorldToViewportPoint(trackingPart.Position)
			if onScreen then
				local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
				
				-- Ensure they are technically inside the bounds perimeter circle
				if distToCenter <= FOV_RADIUS then
					local worldDistance = (trackingPart.Position - camera.CFrame.Position).Magnitude
					
					-- ABSOLUTE DISTANCE IS PARAMOUNT: By evaluating world distance directly first, 
					-- an enemy right next to you on the edge of the FOV will completely override a far away crosshair target.
					if worldDistance < closestWorldDistance then
						if isPartVisible(trackingPart) then 
							closestWorldDistance = worldDistance 
							closestChar = character 
						end
					end
				end
			end
		end
	end
	return closestChar
end

-- High Contrast Toggle Transitions
local function uiAnimateState(activated)
	if activated then
		textButton.Text = "TARGET: LOCKED"
		textButton.TextColor3 = Color3.fromRGB(0, 255, 100) 
	else
		textButton.Text = "TARGET: UNLOCKED"
		textButton.TextColor3 = Color3.fromRGB(255, 50, 50) 
	end
end

local function startLockOnTarget(chosenTarget)
	target = chosenTarget uiAnimateState(true) locked = true
	espHighlight.Adornee = target
	espHighlight.Enabled = true
	
	lockConnection = RunService.RenderStepped:Connect(function()
		local trackingPart = getTargetPart(target)
		if target and trackingPart and target:FindFirstChildOfClass("Humanoid") and target.Humanoid.Health > 0 then
			local targetPlayer = Players:GetPlayerFromCharacter(target)
			if targetPlayer and isFriend(targetPlayer) then stopLockOnTarget() return end
			
			if not isPartVisible(trackingPart) then stopLockOnTarget() return end
			camera.CFrame = CFrame.new(camera.CFrame.Position, trackingPart.Position)
		else 
			stopLockOnTarget() 
		end
	end)
end

function stopLockOnTarget()
	if lockConnection then lockConnection:Disconnect() lockConnection = nil end
	espHighlight.Enabled = false
	espHighlight.Adornee = nil
	target = nil locked = false uiAnimateState(false)
end

textButton.MouseButton1Click:Connect(function()
	if locked then 
		stopLockOnTarget() 
		if autolockEnabled then
			autolockCooldownActive = true
			task.delay(COOLDOWN_DURATION, function() autolockCooldownActive = false end)
		end
	else
		if autolockEnabled and autolockCooldownActive then return end 
		local possibleTarget = getClosestCharacterToCenter()
		if possibleTarget then startLockOnTarget(possibleTarget) end
	end
end)

