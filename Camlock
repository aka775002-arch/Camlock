-- Anti-Cheat Multiplier Bypass Layer Logic
RunService.PreSimulation:Connect(function()
local character = localPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if humanoid and shared.modifiersActive then
humanoid.WalkSpeed = shared.walkSpeedValue
humanoid.UseJumpPower = true
humanoid.JumpPower = shared.jumpPowerValue
pcall(function()
humanoid.JumpHeight = (shared.jumpPowerValue * shared.jumpPowerValue) / (2 * workspace.Gravity)
end)
end
end)
