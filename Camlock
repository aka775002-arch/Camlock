function shared.updateEspSectors()
if not shared.espMasterEnabled then
shared.clearTargetEsp()
return
end
for _, p in ipairs(Players:GetPlayers()) do
if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") then
if not shared.activeEspStorage[p] or shared.activeEspStorage[p].characterLink ~= p.Character then
shared.makeEsp(p)
end
end
end
local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
local currentRainbowColor = Color3.fromHSV((tick() * shared.RAINBOW_SPEED) % 1, 0.95, 1)
for plr, data in pairs(shared.activeEspStorage) do
local char = data.characterLink
local folder = data.folder
if not char.Parent or not folder.Parent then
if folder then folder:Destroy() end
shared.activeEspStorage[plr] = nil
continue
end
local hum = char:FindFirstChildOfClass("Humanoid")
local root = char:FindFirstChild("HumanoidRootPart")
if hum and root and localRoot and hum.Health > 0 then
local distance = math.floor((localRoot.Position - root.Position).Magnitude)
local currentWeapon = getEquippedWeapon(plr)
data.label.Text = string.format("[%s]\nName: %s | HP: %s | Studs: %d", currentWeapon, plr.Name, string.format("%.1f", hum.Health), distance)
local assignedColor = Color3.fromRGB(255, 60, 60)
local isTeammate = localPlayer.Team and plr.Team and (localPlayer.Team == plr.Team)
local isFriend = localPlayer:IsFriendsWith(plr.UserId)
if isTeammate then
assignedColor = currentRainbowColor
elseif isFriend then
assignedColor = Color3.fromRGB(60, 255, 60)
elseif shared.wallEspEnabled and shared.isWallBetween(root) then
assignedColor = Color3.fromRGB(0, 120, 255)
end
if data.highlight then
data.highlight.OutlineColor = assignedColor
data.highlight.FillColor = assignedColor
end
data.label.TextColor3 = assignedColor
for _, boxHandle in ipairs(data.boxes) do
if boxHandle and boxHandle.Parent then
boxHandle.Color3 = assignedColor
end
end
else
if folder then folder:Destroy() end
shared.activeEspStorage[plr] = nil
end
end
end
for _, player in ipairs(Players:GetPlayers()) do shared.makeEsp(player) end
Players.PlayerAdded:Connect(shared.makeEsp)
