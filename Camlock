local function round(num, numDecimalPlaces)
	local mult = 10^(numDecimalPlaces or 0)
	return math.floor(num * mult + 0.5) / mult
end

local function getEquippedWeapon(char)
	if not char then return "NONE" end
	local tool = char:FindFirstChildOfClass("Tool")
	return tool and tool.Name:upper() or "NONE"
end

function shared.makeEsp(plr, isNpc)
	local char = isNpc and plr or plr.Character
	if not char or char == localPlayer.Character then return end
	
	local identifier = isNpc and plr.Name .. "_NPC_ESP" or plr.Name .. "_ESP"
	
	local existing = CoreGui:FindFirstChild(identifier)
	if existing then existing:Destroy() end
	
	local targetAdornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("Part")
	if not targetAdornee then return end
	
	local ESPholder = Instance.new("Folder")
	ESPholder.Name = identifier
	ESPholder.Parent = CoreGui
	
	local highlight = Instance.new("Highlight")
	highlight.Name = "EspOutline"
	highlight.Adornee = char
	highlight.FillTransparency = 0.85
	highlight.OutlineTransparency = 0.15
	highlight.Parent = ESPholder
	
	local BillboardGui = Instance.new("BillboardGui")
	local TextLabel = Instance.new("TextLabel")
	
	BillboardGui.Adornee = targetAdornee
	BillboardGui.Name = "EspTextGui"
	BillboardGui.Parent = ESPholder
	BillboardGui.Size = UDim2.new(0, 150, 0, 150)
	BillboardGui.StudsOffset = Vector3.new(0, 1.5, 0)
	BillboardGui.AlwaysOnTop = true
	
	TextLabel.Parent = BillboardGui
	TextLabel.BackgroundTransparency = 1
	TextLabel.Position = UDim2.new(0, -25, 0, -50)
	TextLabel.Size = UDim2.new(0, 200, 0, 100)
	TextLabel.Font = Enum.Font.GothamBold
	TextLabel.TextSize = 13.5
	TextLabel.TextColor3 = Color3.new(1, 1, 1)
	TextLabel.TextStrokeTransparency = 0.1
	TextLabel.TextYAlignment = Enum.TextYAlignment.Bottom
	TextLabel.ZIndex = 10
	
	shared.activeEspStorage[char] = {
		gui = ESPholder, 
		label = TextLabel, 
		coreHighlight = highlight, 
		npcFlag = isNpc, 
		playerLink = isNpc and nil or plr
	}
end

function shared.updateEspSectors()
	if not shared.espMasterEnabled then 
		for char, i in pairs(shared.activeEspStorage) do if i.gui then i.gui:Destroy() end end
		table.clear(shared.activeEspStorage)
		
		for _, c in pairs(CoreGui:GetChildren()) do
			if string.sub(c.Name, -4) == "_ESP" then c:Destroy() end
		end
		return 
	end
	
	for char, i in pairs(shared.activeEspStorage) do 
		if not char.Parent or (char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health <= 0) then 
			if i.gui then i.gui:Destroy() end
			shared.activeEspStorage[char] = nil 
		end 
	end
	
	if shared.targetMode == "Players" or shared.targetMode == "All" then
		for _, p in ipairs(Players:GetPlayers()) do 
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then 
				if not shared.activeEspStorage[p.Character] then shared.makeEsp(p, false) end
			end 
		end
	end
	
	if shared.targetMode == "NPCs" or shared.targetMode == "All" then
		for _, d in ipairs(workspace:GetDescendants()) do 
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") and d ~= localPlayer.Character and not Players:GetPlayerFromCharacter(d) then 
				if d:FindFirstChild("HumanoidRootPart") and not shared.activeEspStorage[d] then 
					shared.makeEsp(d, true) 
				end
			end 
		end
	end
	
	local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	local currentRainbowColor = Color3.fromHSV((tick() * shared.RAINBOW_SPEED) % 1, 0.95, 1)

	for char, data in pairs(shared.activeEspStorage) do
		if (shared.targetMode == "Players" and data.npcFlag) or (shared.targetMode == "NPCs" and not data.npcFlag) then
			if data.gui then data.gui:Destroy() end
			shared.activeEspStorage[char] = nil; continue
		end
		
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		if hum and root and localRoot then
			local distance = math.floor((root.Position - localRoot.Position).Magnitude)
			local nameText = data.npcFlag and "NPC: " .. char.Name or data.playerLink.Name
			local equippedWeapon = getEquippedWeapon(char)
			
			data.label.Text = string.format("WEAPON: %s\nNAME: %s | HP: %s | DIST: %d", equippedWeapon, nameText:upper(), string.format("%.1f", hum.Health), distance)
			
			-- Priority Coloring Hierarchy Rules System
			local espColor = Color3.fromRGB(255, 60, 60) -- Default Fallback: Enemy Red
			local isTeammate = false

			if data.playerLink then
				local isFriend = localPlayer:IsFriendsWith(data.playerLink.UserId)
				local isSameTeam = localPlayer.Team and data.playerLink.Team and (localPlayer.Team == data.playerLink.Team)
				if isFriend or isSameTeam then
					isTeammate = true
				end
			end

			if isTeammate then
				espColor = currentRainbowColor -- Rule 1: Friends/Teammates = Rainbow Highlight
			elseif shared.wallCheckEnabled and shared.isWallBetween(root) then 
				espColor = Color3.fromRGB(0, 240, 255) -- Rule 2: Behind Walls = Cyan
			elseif data.npcFlag then 
				espColor = Color3.fromRGB(245, 245, 60) -- Rule 3: Neutral Targets = Yellow
			end
			
			data.coreHighlight.OutlineColor = espColor
			data.coreHighlight.FillColor = espColor
			data.label.TextColor3 = Color3.new(1, 1, 1)
		end
	end
end
