for _, textObj in ipairs(textSyncList) do if textObj.TextColor3 ~= Color3.fromRGB(255, 60, 60) and textObj.TextColor3 ~= Color3.fromRGB(255, 120, 120) then textObj.TextColor3 = dynamicColor end end
